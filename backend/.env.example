# Required
GROQ_API_KEY=your_groq_api_key
MONGODB_URI=your_mongodb_connection_string
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_long_random_secret

# Optional
PORT=5000
# Comma-separated browser origins allowed to call the API. Set this to your deployed frontend URL.
CLIENT_ORIGINS=http://localhost:5173
# Number of reverse proxies in front of the API, used to find the real client IP for rate limiting.
TRUST_PROXY=1
# DNS servers used for mongodb+srv lookups. Leave empty to use the system resolver.
DNS_SERVERS=8.8.8.8,1.1.1.1
